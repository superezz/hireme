# Server Port
PORT=3001

# MongoDB Connection String (Required)
# Do not use the production database for local development.
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.../inqora

# JWT Secret Key (Required)
# A long, secure random string used to sign session tokens.
JWT_SECRET=supersecretjwtkey123

# Gemini AI API Keys (Required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-3.6-flash

# ImageKit Credentials (Required for image uploads)
IMAGEKIT_PUBLIC_KEY=public_imagekit_key
IMAGEKIT_PRIVATE_KEY=private_imagekit_key

# URL of the frontend client (Required for CORS)
CLIENT_URL=http://localhost:5173

# (Optional/Legacy) Clerk Secret Key 
CLERK_SECRET_KEY=sk_test_...
